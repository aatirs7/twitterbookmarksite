{
  "name": "twitterbookmarksite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm ext:build && pnpm ext:zip && next build",
    "start": "next start",
    "lint": "eslint",
    "ext:build": "pnpm --dir extension install --production=false && pnpm --dir extension build",
    "ext:build:dev": "pnpm --dir extension install --production=false && pnpm --dir extension build:dev",
    "ext:typecheck": "pnpm --dir extension typecheck",
    "ext:zip": "node scripts/zip-extension.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/smoke-db.ts",
    "tag": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/tag-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@base-ui/react": "^1.8.0",
    "@neondatabase/serverless": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.15.0"
}
