DATABASE_URL=
# Password for the single owner login; SESSION_SECRET signs the session cookie.
TROVE_PASSWORD=
SESSION_SECRET=
# AI tagging and summaries are skipped when this is empty.
ANTHROPIC_API_KEY=
CRON_SECRET=
# Set after loading the extension (shown on its Options page). Comma separated.
EXTENSION_ORIGIN=chrome-extension://<id>
# Build time only: the Trove Web URL baked into the extension's host permissions.
TROVE_URL=
BLOB_READ_WRITE_TOKEN=
